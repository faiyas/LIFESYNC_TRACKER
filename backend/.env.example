# LifeSync AI Backend Environment Config
SECRET_KEY=django-insecure-lifesync-ai-secret-key-replace-in-production-123456
DEBUG=True
ALLOWED_HOSTS=*

# NVIDIA NIM API (Get free credits at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium

# Server Port
PORT=8000
